# Cliente OAuth de Google Cloud. Alcance: https://www.googleapis.com/auth/adwords
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional. Si no está, se usa el origen de la request + /api/google/callback
GOOGLE_REDIRECT_URI=

# Opcional. Desde el 9 de septiembre de 2026 el developer token se ignora.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Clave del panel. Si está vacía, el panel queda abierto.
APP_PASSWORD=

# Protege GET /api/cron/audit. Vercel Cron manda Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Modelo del AI Gateway para la lectura de un hallazgo. Si cita cifras ajenas, se descarta.
AI_MODEL=openai/gpt-5.4

# Supabase. Sin estas variables el auditor usa .data/store.json
SUPABASE_URL=
SUPABASE_SECRET_KEY=
